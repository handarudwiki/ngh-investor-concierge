# Concierge engine. With an Anthropic credential set, replies are drafted by
# Claude from the approved knowledge base; without one, the rules engine answers.
ANTHROPIC_API_KEY=

# Optional: force "claude" or "rules". Defaults to claude when a key is present.
# CONCIERGE_ENGINE=rules

# Optional: override the model (default claude-opus-5-5).
# CONCIERGE_MODEL=claude-opus-5-5
